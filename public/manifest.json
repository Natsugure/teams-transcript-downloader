{
  "manifest_version": 3,
  "name": "Teams Transcript Downloader",
  "description": "Microsoft Teamsのトランスクリプト（字幕）をVTTファイルとしてダウンロードできる拡張機能",
  "version": "1.0.0",
  "permissions": [
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "https://*.sharepoint.com/*"
  ],
  "action": {
    "default_icon": {
      "16": "icon16.png",
      "48": "icon48.png",
      "128": "icon128.png"
    },
    "default_title": "トランスクリプトをダウンロード"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://*.sharepoint.com/*/stream.aspx*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  }
}
